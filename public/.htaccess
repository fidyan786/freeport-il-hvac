# Generated by scripts/write-htaccess.mjs. Do not edit by hand.
# Hostinger shared hosting (Apache or LiteSpeed). Static files live in public_html.
Options -Indexes -MultiViews
DirectoryIndex index.html

ErrorDocument 404 /404.html

<FilesMatch "^(icon|apple-icon|opengraph-image)$">
  ForceType image/png
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com https://analytics.google.com https://stats.g.doubleclick.net; worker-src 'self' blob:; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()"
  Header always set X-DNS-Prefetch-Control "off"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Extensionless Next image routes are real PNG files. Map the trailing-slash URL onto the file.
  RewriteRule ^((?:.*/)?)(opengraph-image|apple-icon|icon)/$ /$1$2 [L]

  # Old URLs, either slash form, any host or scheme: one hop to the https apex.
  # NC folds uppercase variants into the same lowercase destination.
RewriteRule ^ac-repair-freeport-il/?$ https://freeporthvacil.com/services/ac-repair-freeport-il/ [R=301,L,NC]
RewriteRule ^ac-installation-freeport-il/?$ https://freeporthvacil.com/services/ac-installation-freeport-il/ [R=301,L,NC]
RewriteRule ^ac-installation-replacement-freeport-il/?$ https://freeporthvacil.com/services/ac-installation-freeport-il/ [R=301,L,NC]
RewriteRule ^ac-maintenance-freeport-il/?$ https://freeporthvacil.com/services/hvac-maintenance-freeport-il/ [R=301,L,NC]
RewriteRule ^ac-replacement-freeport-il/?$ https://freeporthvacil.com/services/ac-installation-freeport-il/ [R=301,L,NC]
RewriteRule ^furnace-repair-freeport-il/?$ https://freeporthvacil.com/services/furnace-repair-freeport-il/ [R=301,L,NC]
RewriteRule ^furnace-installation-freeport-il/?$ https://freeporthvacil.com/services/furnace-installation-freeport-il/ [R=301,L,NC]
RewriteRule ^furnace-installation-replacement-freeport-il/?$ https://freeporthvacil.com/services/furnace-installation-freeport-il/ [R=301,L,NC]
RewriteRule ^heating-maintenance-freeport-il/?$ https://freeporthvacil.com/services/hvac-maintenance-freeport-il/ [R=301,L,NC]
RewriteRule ^hvac-maintenance-freeport-il/?$ https://freeporthvacil.com/services/hvac-maintenance-freeport-il/ [R=301,L,NC]
RewriteRule ^hvac-replacement-freeport-il/?$ https://freeporthvacil.com/services/residential-hvac-freeport-il/ [R=301,L,NC]
RewriteRule ^hvac-repair-freeport-il/?$ https://freeporthvacil.com/services/residential-hvac-freeport-il/ [R=301,L,NC]
RewriteRule ^heat-pump-repair-freeport-il/?$ https://freeporthvacil.com/services/heat-pump-repair-freeport-il/ [R=301,L,NC]
RewriteRule ^heat-pump-installation-freeport-il/?$ https://freeporthvacil.com/services/heat-pump-repair-freeport-il/ [R=301,L,NC]

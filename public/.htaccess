RewriteRule ^heating-and-cooling-freeport-il/?$ https://freeporthvacil.com/ [R=301,L,NC]
RewriteRule ^air-conditioning-repair-freeport-il/?$ https://freeporthvacil.com/services/ac-repair-freeport-il/ [R=301,L,NC]
RewriteRule ^service-areas/?$ https://freeporthvacil.com/service-area/ [R=301,L,NC]
RewriteRule ^reviews/?$ https://freeporthvacil.com/about/ [R=301,L,NC]
RewriteRule ^blog/?$ https://freeporthvacil.com/guides/ [R=301,L,NC]
RewriteRule ^blog/furnace-stops-working-freeport-winter/?$ https://freeporthvacil.com/guides/furnace-not-heating/ [R=301,L,NC]
RewriteRule ^blog/ac-fails-after-illinois-winter/?$ https://freeporthvacil.com/guides/ac-blowing-warm-air/ [R=301,L,NC]

RewriteRule ^services/furnace-maintenance-freeport-il/?$ https://freeporthvacil.com/services/hvac-maintenance-freeport-il/ [R=301,L,NC]
RewriteRule ^services/hvac-repair-freeport-il/?$ https://freeporthvacil.com/services/residential-hvac-freeport-il/ [R=301,L,NC]
RewriteRule ^services/hvac-replacement-freeport-il/?$ https://freeporthvacil.com/services/residential-hvac-freeport-il/ [R=301,L,NC]
RewriteRule ^services/heat-pump-installation-freeport-il/?$ https://freeporthvacil.com/services/heat-pump-repair-freeport-il/ [R=301,L,NC]
RewriteRule ^services/heat-pump-maintenance-freeport-il/?$ https://freeporthvacil.com/services/heat-pump-repair-freeport-il/ [R=301,L,NC]
RewriteRule ^services/mini-split-repair-freeport-il/?$ https://freeporthvacil.com/services/ductless-mini-split-freeport-il/ [R=301,L,NC]
RewriteRule ^services/mini-split-installation-freeport-il/?$ https://freeporthvacil.com/services/ductless-mini-split-freeport-il/ [R=301,L,NC]
RewriteRule ^services/air-filtration-freeport-il/?$ https://freeporthvacil.com/services/indoor-air-quality-freeport-il/ [R=301,L,NC]
RewriteRule ^services/humidifiers-dehumidifiers-freeport-il/?$ https://freeporthvacil.com/services/indoor-air-quality-freeport-il/ [R=301,L,NC]
RewriteRule ^services/commercial-ac-repair-freeport-il/?$ https://freeporthvacil.com/services/commercial-hvac-freeport-il/ [R=301,L,NC]
RewriteRule ^services/commercial-heating-repair-freeport-il/?$ https://freeporthvacil.com/services/commercial-hvac-freeport-il/ [R=301,L,NC]
RewriteRule ^services/commercial-hvac-maintenance-freeport-il/?$ https://freeporthvacil.com/services/commercial-hvac-freeport-il/ [R=301,L,NC]
RewriteRule ^guides/ac-freezing-up/?$ https://freeporthvacil.com/guides/ac-not-turning-on/ [R=301,L,NC]
RewriteRule ^guides/ac-constantly-running/?$ https://freeporthvacil.com/services/ac-repair-freeport-il/ [R=301,L,NC]
RewriteRule ^guides/hvac-maintenance-checklist/?$ https://freeporthvacil.com/services/hvac-maintenance-freeport-il/ [R=301,L,NC]
RewriteRule ^guides/indoor-air-quality-closed-homes/?$ https://freeporthvacil.com/services/indoor-air-quality-freeport-il/ [R=301,L,NC]
RewriteRule ^blog/heat-pumps-northern-illinois/?$ https://freeporthvacil.com/guides/heat-pump-basics-northern-illinois/ [R=301,L,NC]

  # www to the apex, on either scheme.
  RewriteCond %{HTTP_HOST} ^www\.freeporthvacil\.com$ [NC]
  RewriteRule ^ https://freeporthvacil.com%{REQUEST_URI} [R=301,L]

  # Plain http to https. Skip when Hostinger already terminated TLS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://freeporthvacil.com%{REQUEST_URI} [R=301,L]

  # Trailing slash for pages. Real files (sitemap, robots, images, 404.html) stay put.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{1,5}$
  RewriteRule ^(.+)$ https://freeporthvacil.com/$1/ [R=301,L]
</IfModule>

# Public site identity — replace placeholders before advertising.
NEXT_PUBLIC_BUSINESS_NAME=[BUSINESS NAME]
NEXT_PUBLIC_PHONE_DISPLAY=[PHONE NUMBER]
NEXT_PUBLIC_PHONE_TEL=
NEXT_PUBLIC_BUSINESS_HOURS=[BUSINESS HOURS]
NEXT_PUBLIC_SITE_URL=

# Optional. Leave blank until real IDs exist.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional. POST JSON leads here when a CRM/webhook is ready.
FORM_WEBHOOK=

# Optional. Vercel AI Gateway key for chatbot reply polishing.
# On Vercel, OIDC is used automatically if AI Gateway is enabled.
# Without this, the chatbot still qualifies leads and shows Call Now.
AI_GATEWAY_API_KEY=

# Public site identity. Phone defaults in src/lib/site.ts; env overrides for tracking.
NEXT_PUBLIC_BUSINESS_NAME=Millrace Heating & Air
NEXT_PUBLIC_PHONE_DISPLAY=888-989-8898
NEXT_PUBLIC_PHONE_TEL=8889898898
NEXT_PUBLIC_BUSINESS_HOURS=
NEXT_PUBLIC_SITE_URL=

# Optional. Leave blank until real IDs exist.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional. POST JSON leads here when a CRM/webhook is ready.
FORM_WEBHOOK=

# Optional. Vercel AI Gateway key for chatbot reply polishing.
# On Vercel, OIDC is used automatically if AI Gateway is enabled.
# Without this, the chatbot still qualifies leads and shows Call Now.
AI_GATEWAY_API_KEY=

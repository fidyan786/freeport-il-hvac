# Public site identity. Phone defaults in src/lib/site.ts; env overrides for tracking.
NEXT_PUBLIC_BUSINESS_NAME=Millrace Heating & Air
NEXT_PUBLIC_PHONE_DISPLAY=(703) 703-7855
NEXT_PUBLIC_PHONE_TEL=7037037855
NEXT_PUBLIC_BUSINESS_HOURS=
# Optional override. Leave unset to use https://freeporthvacil.com.
# Do not set this to a vercel.app host.
NEXT_PUBLIC_SITE_URL=

# Optional. Leave blank until real IDs exist.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag content value (not a made-up string).
# Also accepted as GOOGLE_SITE_VERIFICATION.
# Live production currently uses the token already in src/lib/site.ts
# (EXISTING_GOOGLE_SITE_VERIFICATION) plus /google7129b29a73db544e.html.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

